#include <stdio.h>

int main() {
    int n = 12345, reversed = 0, remainder;
    int original = n;
    
    while (n != 0) {
        remainder = n % 10;
        reversed = reversed * 10 + remainder;
        n /= 10;
    }
    printf("Original: %d, Reversed: %d\n", original, reversed);
    return 0;
}
